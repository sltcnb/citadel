              "type": "long"
            },
            "parent_command_line": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 4096
                },
                "ci": {
                  "type": "keyword",
                  "normalizer": "citadel_ci",
                  "ignore_above": 8192
                }
              },
              "copy_to": "search_all"
            },
            "user": {
              "type": "keyword",
              "copy_to": "search_all"
            },
            "integrity_level": {
              "type": "keyword",
              "copy_to": "search_all"
            },
            "hash_md5": {
              "type": "keyword",
              "copy_to": "search_all"
            },
            "hash_sha1": {
              "type": "keyword",
              "copy_to": "search_all"
            },
            "hash_sha256": {
              "type": "keyword",
              "copy_to": "search_all"
            },
            "elevation_token": {
              "type": "keyword",
              "copy_to": "search_all"
            },
            "logon_id": {
              "type": "keyword",
