            },
            "value_type": {
              "type": "keyword",
              "copy_to": "search_all"
            },
            "value_data": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 2048
                },
                "ci": {
                  "type": "keyword",
                  "normalizer": "citadel_ci",
                  "ignore_above": 8192
                }
