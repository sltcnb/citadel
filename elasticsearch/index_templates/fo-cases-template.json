{
  "index_patterns": [
    "fo-case-*"
  ],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "5s",
      "index.mapping.total_fields.limit": 6000,
      "analysis": {
        "normalizer": {
          "citadel_ci": {
            "type": "custom",
            "filter": [
              "lowercase"
            ]
          }
        }
      }
    },
    "mappings": {
      "dynamic": "true",
      "dynamic_templates": [
        {
          "ci_paths": {
            "path_match": [
              "lnk.*",
              "mft.*",
              "prefetch.*",
              "syslog.*",
              "shell_history.*",
              "persistence.*",
              "shimcache.*",
              "userassist.*",
              "browser.*",
              "suricata.*",
              "zeek.*",
              "access_log.*",
              "iis_access_log.*",
              "evtx.event_data.*",
              "cloud_audit.*",
              "aws_cloudtrail.*",
              "azure_signin.*",
              "gcp_audit.*",
              "o365_audit.*",
              "okta_system_log.*"
            ],
            "match_mapping_type": "string",
            "mapping": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 1024
                },
                "ci": {
                  "type": "keyword",
                  "normalizer": "citadel_ci",
                  "ignore_above": 8192
                }
              },
              "copy_to": "search_all"
            }
          }
        },
        {
          "strings_as_text_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              },
              "copy_to": "search_all"
            }
          }
        }
      ],
      "properties": {
        "fo_id": {
          "type": "keyword"
        },
        "case_id": {
          "type": "keyword"
        },
        "artifact_type": {
          "type": "keyword",
          "copy_to": "search_all"
        },
        "os": {
          "type": "keyword",
          "copy_to": "search_all"
        },
        "source_file": {
          "type": "keyword",
          "index": false,
          "copy_to": "search_all"
        },
        "ingest_job_id": {
          "type": "keyword"
        },
        "ingested_at": {
          "type": "date"
        },
        "timestamp": {
          "type": "date"
        },
        "timestamp_desc": {
          "type": "keyword",
          "copy_to": "search_all"
        },
        "message": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "ci": {
              "type": "keyword",
              "normalizer": "citadel_ci",
              "ignore_above": 8192
            }
          },
          "copy_to": "search_all"
        },
        "tags": {
          "type": "keyword",
          "copy_to": "search_all"
        },
        "analyst_note": {
          "type": "text",
          "copy_to": "search_all"
        },
        "is_flagged": {
          "type": "boolean"
        },
        "is_pinned": {
          "type": "boolean"
        },
        "pin_note": {
          "type": "text",
          "copy_to": "search_all"
        },
        "host": {
          "type": "object",
          "dynamic": true,
          "properties": {
            "hostname": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword"
                }
              },
              "copy_to": "search_all"
            },
            "fqdn": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword"
                }
              },
              "copy_to": "search_all"
            },
            "ip": {
              "type": "ip",
              "fields": {
                "keyword": {
                  "type": "keyword"
                }
              },
              "copy_to": "search_all"
            },
            "os": {
              "type": "keyword",
              "copy_to": "search_all"
            },
            "os_version": {
              "type": "keyword",
              "copy_to": "search_all"
            },
            "domain": {
              "type": "keyword",
              "copy_to": "search_all"
            },
            "timezone": {
              "type": "keyword",
              "copy_to": "search_all"
            }
          }
        },
        "user": {
          "type": "object",
          "dynamic": true,
          "properties": {
            "name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword"
                }
              },
              "copy_to": "search_all"
            },
            "domain": {
              "type": "keyword",
              "copy_to": "search_all"
            },
            "sid": {
              "type": "keyword",
              "copy_to": "search_all"
            },
            "type": {
              "type": "keyword",
              "copy_to": "search_all"
            },
            "id": {
              "type": "keyword",
              "copy_to": "search_all"
            }
          }
        },
        "process": {
          "type": "object",
          "dynamic": true,
          "properties": {
            "name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword"
                }
              },
              "copy_to": "search_all"
            },
            "executable_name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword"
                }
              },
              "copy_to": "search_all"
            },
            "path": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword"
                },
                "ci": {
                  "type": "keyword",
