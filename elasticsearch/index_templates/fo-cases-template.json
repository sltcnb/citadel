                "keyword": {
                  "type": "keyword"
                }
              },
              "copy_to": "search_all"
            },
            "correlation_activity_id": {
              "type": "keyword",
              "copy_to": "search_all"
            }
          }
        },
        "prefetch": {
          "type": "object",
          "dynamic": true,
          "properties": {
            "executable_name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword"
                }
              },
              "copy_to": "search_all"
            },
            "executable_hash": {
              "type": "keyword",
              "copy_to": "search_all"
            },
            "run_count": {
              "type": "long"
            },
            "last_run_time": {
