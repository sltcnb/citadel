            },
            "protocol": {
              "type": "keyword",
              "copy_to": "search_all"
            },
            "action": {
              "type": "keyword",
              "copy_to": "search_all"
            },
            "bytes": {
              "type": "long"
            },
            "direction": {
              "type": "keyword",
              "copy_to": "search_all"
            }
          }
        },
        "http": {
          "type": "object",
          "dynamic": true,
          "properties": {
            "method": {
              "type": "keyword",
