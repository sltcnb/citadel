            },
            "command_line": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 4096
                },
                "ci": {
                  "type": "keyword",
                  "normalizer": "citadel_ci",
                  "ignore_above": 8192
                }
              },
              "copy_to": "search_all"
            },
            "args": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword"
                }
              },
              "copy_to": "search_all"
            },
            "pid": {
              "type": "long"
            },
            "ppid": {
              "type": "long"
            },
            "parent_name": {
