# ══════════════════════════════════════════════════════════════════════════════
# Citadel — environment configuration
# Copy this file to .env and fill in your values.
# All variables have sane defaults. The secrets below (JWT_SECRET,
# ELASTIC_PASSWORD, KIBANA_PASSWORD, REDIS_PASSWORD) are left EMPTY on purpose:
# `./foctl deploy docker` / `./foctl ensure-env` generates strong random values
# into .env on first run (stable across redeploys) — the compose files fail
# closed on empty values. Generate by hand with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ══════════════════════════════════════════════════════════════════════════════

# ── Authentication (REQUIRED — generated by foctl if left empty) ─────────────
JWT_SECRET=

# Token lifetime in hours (default: 8)
JWT_EXPIRE_HOURS=8

# Disable to allow unauthenticated access (dev/trusted-LAN only).
# Disabling grants every request unrestricted admin, so it ALSO requires the
# explicit opt-in below — otherwise startup fails closed and re-enables auth.
AUTH_ENABLED=true
# CITADEL_ALLOW_NO_AUTH=true   # required second opt-in to actually run with AUTH_ENABLED=false

# ── Elasticsearch ─────────────────────────────────────────────────────────────
# Password for the built-in `elastic` superuser (REQUIRED — generated by foctl
# if left empty). API + workers authenticate with it.
ELASTIC_PASSWORD=
# Password Kibana uses for the built-in `kibana_system` user (REQUIRED —
# generated by foctl if left empty). NOTE: foctl's k8s flow sets this user's
# password inside ES automatically; for a manual docker deploy set it once with:
#   curl -u elastic:$ELASTIC_PASSWORD -X POST \
#     http://localhost:9200/_security/user/kibana_system/_password \
#     -H 'Content-Type: application/json' -d "{\"password\": \"$KIBANA_PASSWORD\"}"
KIBANA_PASSWORD=

# JVM heap per node. Set to ~50% of available RAM, max 31g.
# Example: 2g for a 4GB node, 8g for a 16GB node.
ES_HEAP_SIZE=1g

# ── Redis ─────────────────────────────────────────────────────────────────────
# Auth password (REQUIRED — generated by foctl if left empty). Clients connect
# with redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_PASSWORD=

# ── MinIO object storage ───────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
# Use a strong password in production
MINIO_SECRET_KEY=minioadmin

# Redis maxmemory cap. Raise if you process many large cases in parallel.
REDIS_MAXMEM=2gb

# ── API ───────────────────────────────────────────────────────────────────────
# Number of Uvicorn worker processes (async I/O bound — 4 is a good baseline)
API_WORKERS=4

# ── Celery workers ────────────────────────────────────────────────────────────
# Parallel ingest tasks per worker (I/O-bound: MinIO download + ES writes)
INGEST_CONCURRENCY=4

# Parallel module tasks per worker (CPU-bound: Hayabusa, Volatility3, YARA)
# Keep this low (2-4) to avoid OOM when running heavy analysis binaries.
MODULE_CONCURRENCY=2

# Tasks per child process before recycling (guards against memory leaks in
# Python plugins that process large forensic files)
WORKER_MAX_TASKS=50

# Elasticsearch bulk indexing batch size (higher = fewer round trips, more RAM)
BULK_SIZE=1000

# ── Observability ─────────────────────────────────────────────────────────────
# Product telemetry: structured events (errors, requests, task outcomes, LLM
# calls, browser crashes) written to Elasticsearch as citadel-telemetry-*, read
# back via /api/v1/admin/telemetry/* and the Telemetry page. This is what tells
# you what to fix next — see docs/OBSERVABILITY.md. Set false to disable it
# entirely (every emit becomes a no-op).
CITADEL_TELEMETRY_ENABLED=true

# How long telemetry is kept. Enforced by an ILM delete phase and by an explicit
# daily prune, so it stays bounded even on a cluster without ILM.
CITADEL_TELEMETRY_RETENTION_DAYS=30

# Fraction of fast, successful GETs recorded. Errors, mutations and slow
# requests are ALWAYS recorded regardless — this only trims the happy path.
CITADEL_TELEMETRY_SAMPLE_RATE=0.05

# Above this many milliseconds a request is always recorded, never sampled away.
CITADEL_TELEMETRY_SLOW_REQUEST_MS=1000

# ── Reverse proxy / multi-app servers ────────────────────────────────────────
# If you already have nginx/Caddy/HAProxy in front and this server runs other
# Docker services, move Citadel off port 80 so there is no conflict.
# Example: set PROXY_PORT=8090 and point your upstream proxy to localhost:8090
# Leave at 80 if Citadel is the only thing on this machine.
PROXY_PORT=80

# ── Public URL ────────────────────────────────────────────────────────────────
# Set to the address users will reach this server at — used to generate
# the PowerShell collector download URL on the Collector page.
# Docker: http://<host-ip>   |   K8s: https://your-domain.com
FO_PUBLIC_URL=http://localhost
